        public async Task<PaginatedJobsModel> GetLogbookUserJobs(string sortOrder, string currentSort, int pageNumber, FilterJobsModel filterModel)
        {
            // Nova API: profile/logbook com query params
            var queryParams = $"?sortOrder={sortOrder}&currentSort={currentSort}&page={pageNumber}";
            if (!string.IsNullOrEmpty(filterModel?.Status)) queryParams += $"&status={filterModel.Status}";
            if (!string.IsNullOrEmpty(filterModel?.Departure)) queryParams += $"&departure={filterModel.Departure}";
            if (!string.IsNullOrEmpty(filterModel?.Arrival)) queryParams += $"&arrival={filterModel.Arrival}";

            var url = $"{ApiBaseUrl}profile/logbook{queryParams}";
            SetAuthorizationHeader();

            HttpResponseMessage response = await _client.GetAsync(new Uri(url));
            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                throw new HttpRequestException(errorContent, new Exception($"Error status code: {response.StatusCode}"));
            }

            var json = await response.Content.ReadAsStringAsync();
            var jobs = JsonConvert.DeserializeObject<PaginatedJobsModel>(json);

            return jobs;
        }

        public async Task<JobModel> GetLastUserJob(string userId)
        {
            // Nova API: profile/logbook com limit=1
            var url = $"{ApiBaseUrl}profile/logbook?page=1&limit=1";
            SetAuthorizationHeader();

            HttpResponseMessage response = await _client.GetAsync(new Uri(url));
            if (!response.IsSuccessStatusCode)
            {
                return null;
            }

            var json = await response.Content.ReadAsStringAsync();
            var result = JsonConvert.DeserializeObject<PaginatedJobsModel>(json);
            return result?.Jobs?.FirstOrDefault();
        }

