        public async Task<IList<AirlineFboDbModel>> GetAirlineFBOs(int airlineId)
        {
            // Nova API: GET airlines/{id}/fbos
            var url = $"{ApiBaseUrl}airlines/{airlineId}/fbos";
            SetAuthorizationHeader();

