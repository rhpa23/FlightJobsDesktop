        public async Task<UserStatisticsModel> UpdateUserSettings(UserSettingsModel userSettings)
        {
            // Nova API: PATCH statistics/notification-preferences ou PATCH statistics/weight-unit
            // Depende de quais configurações estão sendo atualizadas
            SetAuthorizationHeader();

            // Atualizar preferências de notificação
            if (userSettings.SendLicenseWarning.HasValue || userSettings.SendAirlineBillsWarning.HasValue)
            {
                var url = $"{ApiBaseUrl}statistics/notification-preferences";
                var body = JsonConvert.SerializeObject(new
                {
                    sendLicenseWarning = userSettings.SendLicenseWarning,
                    sendAirlineBillsWarning = userSettings.SendAirlineBillsWarning
                });

                HttpResponseMessage response = await _client.PatchAsync(
                    new Uri(url),
                    new StringContent(body, Encoding.UTF8, "application/json")
                );

                if (!response.IsSuccessStatusCode)
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    throw new ApiException(errorContent);
                }
            }

            // Atualizar unidade de peso
            if (!string.IsNullOrEmpty(userSettings.WeightUnit))
            {
                var url = $"{ApiBaseUrl}statistics/weight-unit";
                var body = JsonConvert.SerializeObject(new { weightUnit = userSettings.WeightUnit });

                HttpResponseMessage response = await _client.PatchAsync(
                    new Uri(url),
                    new StringContent(body, Encoding.UTF8, "application/json")
                );

                if (!response.IsSuccessStatusCode)
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    throw new ApiException(errorContent);
                }
            }

            // Retorna estatísticas atualizadas
            return await GetUserStatistics(null);
        }

