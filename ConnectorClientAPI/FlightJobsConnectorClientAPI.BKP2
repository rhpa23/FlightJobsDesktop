namespace ConnectorClientAPI
{
    public class LoginApiResponse
    {
        public string access_token { get; set; }
        public UserApiResponse user { get; set; }
    }

    public class UserApiResponse
    {
        public string id { get; set; }
        public string email { get; set; }
        public string name { get; set; }
        public object activeJob { get; set; }
    }

    public class FlightJobsConnectorClientAPI
    {
        public static string SiteUrl { get; set; } = "https://flightjobs.bsite.net/";
        public static string ApiBaseUrl { get; set; } = "https://flightjobs-api.example.com/"; // TODO: Definir URL da nova API
        static HttpClient _client;
        private string _accessToken;

        public FlightJobsConnectorClientAPI()
        {
            HttpClientHandler handler = new HttpClientHandler()
            {
                AllowAutoRedirect = false
            };

            _client = new HttpClient(handler);
            _client.BaseAddress = new Uri(ApiBaseUrl);
            _client.DefaultRequestHeaders.Accept.Clear();
            _client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
        }

        private void SetAuthorizationHeader()
        {
            _client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", _accessToken);
        }

        public async Task<bool> PingUrl(string url)
        {
            try
            {
                var response = await _client.GetAsync(url);
                return response != null && response.StatusCode == HttpStatusCode.Found;
            }
            catch (Exception)
            {
                return false;
            }
        }

        public async Task SaveAvatar(string userId, string fileName)
        {
            // Nova API: PUT profile/avatar com avatarId
            // Nota: fileName pode ser mapeado para avatarId ou pode ser necessário fazer upload primeiro
            var url = $"{ApiBaseUrl}profile/avatar";
            SetAuthorizationHeader();

            var body = JsonConvert.SerializeObject(new { avatarId = fileName });

            HttpResponseMessage response = await _client.PutAsync(
                new Uri(url),
                new StringContent(body, Encoding.UTF8, "application/json")
            );

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                throw new Exception(errorContent);
            }
        }

        public async Task TranfersMoneyToAirline(string userId, int percent)
        {
            // Nova API: POST profile/transfer
            var url = $"{ApiBaseUrl}profile/transfer";
            SetAuthorizationHeader();

            var body = JsonConvert.SerializeObject(new { percent });

            HttpResponseMessage response = await _client.PostAsync(
                new Uri(url),
                new StringContent(body, Encoding.UTF8, "application/json")
            );

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                throw new Exception(errorContent);
            }
        }

        public async Task<LoginResponseModel> Login(string email, string password)
        {
            try
            {
                var url = $"{ApiBaseUrl}auth/login";

                var body = JsonConvert.SerializeObject(new { email, password });

                HttpResponseMessage response = await _client.PostAsync(
                    new Uri(url),
                    new StringContent(body, Encoding.UTF8, "application/json")
                );

                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    var result = JsonConvert.DeserializeObject<LoginApiResponse>(json);

                    // Armazena o token para requisições futuras
                    _accessToken = result.access_token;
                    SetAuthorizationHeader();

                    return new LoginResponseModel()
                    {
                        ActiveJobInfo = result.user?.activeJob != null ? result.user.activeJob.ToString() : "",
                        UserId = result.user?.id,
                        UserName = result.user?.name ?? "<no user name>"
                    };
                }

                return null;
            }
            catch (Exception ex)
            {
                throw new HttpRequestException("Fail to connect FlightJobs API. Please try again and if the error persists contact the site administrator.", ex);
            }
        }

        public async Task UserRegister(UserRegisterModel userModel)
        {
            var url = $"{ApiBaseUrl}auth/register";

            // Mapeia UserRegisterModel para RegisterDto da nova API
            var registerDto = new
            {
                email = userModel.Email,
                password = userModel.Password,
                name = userModel.Name,
            };

            var body = JsonConvert.SerializeObject(registerDto);

            HttpResponseMessage response = await _client.PostAsync(
                new Uri(url),
                new StringContent(body, Encoding.UTF8, "application/json")
            );

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                throw new Exception(errorContent);
            }
        }

        public async Task ConfirmJob(ConfirmJobModel confirmJobModel)
        {
            // Nova API: POST search/confirm
            var url = $"{ApiBaseUrl}search/confirm";
            SetAuthorizationHeader();

            var confirmDto = new
            {
                departureICAO = confirmJobModel.DepartureICAO,
                arrivalICAO = confirmJobModel.ArrivalICAO,
                alternativeICAO = confirmJobModel.AlternativeICAO,
                distance = confirmJobModel.Dist,
                pax = confirmJobModel.Pax,
                cargo = confirmJobModel.Cargo,
                pay = confirmJobModel.Pay,
                aviationType = confirmJobModel.AviationType,
            };

            var jobs = new ArrayList
            {
                confirmJobModel
            };

            var body = JsonConvert.SerializeObject(jobs);
            HttpResponseMessage response = await _client.PostAsync(
                new Uri(url),
                new StringContent(body, Encoding.UTF8, "application/json")
            );

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                throw new ApiException(errorContent);
            }
        }

        public async Task RemoveJob(string userId, long jobId)
        {
            var url = $"{ApiBaseUrl}jobs/{jobId}";
            SetAuthorizationHeader();

            HttpResponseMessage response = await _client.DeleteAsync(new Uri(url));
            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                throw new ApiException(errorContent);
            }
        }

        public async Task<IList<JobListItemModel>> GenerateConfirmJobs(GenerateJobModel generateJobData)
        {
            // Nova API: POST search/generate
            var url = $"{ApiBaseUrl}search/generate";
            SetAuthorizationHeader();

            var generateDto = new
            {
                departure = generateJobData.Departure,
                arrival = generateJobData.Arrival,
                alternative = generateJobData.Alternative,
                aviationType = generateJobData.AviationType,
                passengers = generateJobData.CustomPlaneCapacity?.CustomPassengerCapacity,
                capacityId = generateJobData.CustomPlaneCapacity?.Id,
                paxWeight = generateJobData.CustomPlaneCapacity?.CustomPaxWeight,
                cargoWeight = generateJobData.CustomPlaneCapacity?.CustomCargoCapacityWeight,
            };

            var body = JsonConvert.SerializeObject(generateDto);
            HttpResponseMessage response = await _client.PostAsync(
                new Uri(url),
                new StringContent(body, Encoding.UTF8, "application/json")
            );

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                return JsonConvert.DeserializeObject<IList<JobListItemModel>>(json);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                throw new ApiException(errorContent);
            }
        }

