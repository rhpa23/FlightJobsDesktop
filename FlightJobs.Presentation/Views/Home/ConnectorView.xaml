<UserControl x:Class="FlightJobsDesktop.Views.Home.ConnectorView"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FlightJobsDesktop.ViewModels"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             Background="{StaticResource BackgroundPrimary}">
    <UserControl.DataContext>
        <local:CurrentJobViewModel/>
    </UserControl.DataContext>
    <Grid Background="{StaticResource BackgroundPrimary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition  />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Image Grid.Column="1" Grid.ColumnSpan="3" Source="/img/background/connector-banner.jpg" VerticalAlignment="Top" Margin="20,15,15,0" />
        <Grid Grid.Row="0" Grid.RowSpan="3" Width="255">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Width="250" Style="{StaticResource StackPanelBoxStyle}" Margin="3,15,0,0">
                <TextBlock Text="Airplane" Style="{StaticResource TextBlockHeaderBoxStyle}" Grid.ColumnSpan="2" />
                <Border Style="{StaticResource LightBorderBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Column="0" Grid.Row="0" Content="Payload:"  Margin="15,10,0,5" FontSize="14" Style="{StaticResource LabelSecondaryStyle}"/>
                        <TextBlock Grid.Column="1" Grid.Row="0" Margin="15,10,10,15" FontSize="14" Text="{Binding PlaneSimData.PayloadPoundsAndKilogramsText}"/>
                        <Label Grid.Column="0" Grid.Row="1" Content="Name:"  Margin="15,5,0,15" FontSize="14" Style="{StaticResource LabelSecondaryStyle}"/>
                        <Label Content="{Binding PlaneSimData.Name}"  Grid.Column="1" Grid.Row="1" Margin="15,5,0,15" FontSize="14" />
                        <Label Grid.Column="0" Grid.Row="2" Content="Fuel:"  Margin="15,5,0,5" FontSize="14" Style="{StaticResource LabelSecondaryStyle}"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Margin="15,5,10,5" FontSize="14" Text="{Binding PlaneSimData.FuelWeightPoundsAndKilogramsText}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Width="250" Style="{StaticResource StackPanelBoxStyle}" Margin="3,15,0,0" >
                <TextBlock Text="Weather" Style="{StaticResource TextBlockHeaderBoxStyle}" Grid.ColumnSpan="2" />
                <Border Style="{StaticResource LightBorderBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Baro:" Margin="15,10,0,5" FontSize="14" Style="{StaticResource TextSecondaryStyle}"/>
                        <TextBlock Grid.Column="1" Grid.Row="0" Margin="15,10,0,5" FontSize="14" Text="{Binding SimData.SeaLevelPressureText}"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Wind:" Margin="15,10,0,5" FontSize="14" Style="{StaticResource TextSecondaryStyle}"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Margin="15,10,0,5" FontSize="14" Text="{Binding SimData.WindDirectionAndSpeedText}"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Temp:"  Margin="15,10,0,5" FontSize="14" Style="{StaticResource TextSecondaryStyle}"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SimData.TemperatureCelsiusText}" Margin="15,10,0,5" FontSize="14" />
                        <TextBlock Grid.Column="0" Grid.Row="3" Text="Visibility:"  Margin="15,10,0,5" FontSize="14" Style="{StaticResource TextSecondaryStyle}"/>
                        <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding SimData.VisibilityMetersText}" Margin="15,10,0,5" FontSize="14" />
                    </Grid>
                </Border>
            </StackPanel>
            <DockPanel Grid.Row="2" Width="250" Grid.Column="0" Margin="0,15,0,25">
                <TextBlock Text="Last Job" Style="{StaticResource TextBlockHeaderBoxStyle}" Grid.ColumnSpan="2" DockPanel.Dock="Top" />
                <Border Style="{StaticResource LightBorderBoxStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Column="0" Grid.Row="0" Content="{Binding Path=LastJob.DepartureICAO}" FontSize="20" Padding="5,0,5,0" Margin="5,5,0,5"/>
                        <Label Grid.Column="1" Grid.Row="0" Content="{Binding Path=LastJob.DistComplete}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,0,5,0" Margin="5,10,0,5"/>
                        <Label Grid.Column="2" Grid.Row="0" Content="{Binding Path=LastJob.ArrivalICAO}" FontSize="20" Padding="5,0,5,0" Margin="5,5,0,5"/>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xED28;" FontSize="16" Grid.Column="0" Grid.Row="1" Margin="15,0,0,0"/>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE916;" FontSize="16" Grid.Column="0" Grid.Row="2" Margin="15,0,0,0"/>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE709;" FontSize="16" Grid.Column="0" Grid.Row="3" Margin="15,0,0,0"/>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="18" Grid.Column="0" Grid.Row="4" Margin="15,0,0,0" Foreground="Green"/>
                        <Label Grid.Column="1" Grid.Row="1" Content="{Binding Path=LastJob.EndTime}" FontSize="18" Margin="0,5,0,10" Grid.ColumnSpan="3"/>
                        <Label Grid.Column="1" Grid.Row="2" Content="{Binding Path=LastJob.FlightTime}" FontSize="18" Grid.ColumnSpan="3" Margin="0,5,0,5"/>
                        <Label Grid.Column="1" Grid.Row="3" Content="{Binding Path=LastJob.ModelDescription}" FontSize="10" Grid.ColumnSpan="3" Margin="0,5,0,5"/>
                        <Label Grid.Column="1" Grid.Row="4" Content="{Binding Path=LastJob.PilotScore}" FontSize="14" Grid.ColumnSpan="3" Margin="0,5,0,5"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Margin="20,10,10,25"
                Background="{StaticResource CardGradient}"
                BorderBrush="{StaticResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource AccentPrimaryBg}"
                        BorderBrush="{StaticResource BorderPrimary}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentPrimaryBg}" Margin="0,0,10,0">
                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE709;" FontSize="14" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Current flight" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="16,12">
                    <StackPanel x:Name="PanelNoJob" Orientation="Vertical" Visibility="Collapsed">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentPrimaryBg}" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE709;" FontSize="22" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Welcome to FlightJobs" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="This application only works for MS Flight Simulator with the objective to improve the simulation experience from the point of view of the Pilots Career." FontSize="12" TextWrapping="WrapWithOverflow" Width="480" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                        <Border Height="1" Background="{StaticResource BorderPrimary}" Margin="0,16,0,16" CornerRadius="1"/>
                        <TextBlock Text="You don't have a pending Job. Add jobs to start your next flight." FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <Border x:Name="BtnShowAddJobsBorder" Margin="0,16,0,0" Width="180" Height="38" HorizontalAlignment="Center"
                                Background="{StaticResource AccentPrimary}"
                                CornerRadius="8"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.3" Color="#3b82f6"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentPrimaryHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button x:Name="BtnShowAddJobs" Width="180" Height="38" Click="BtnShowAddJobs_Click" ToolTip="Click here to add a new flight job to do." Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                                    <TextBlock Text="Search flight" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelCurrentJob" Visibility="Collapsed">
                        <Border Background="{StaticResource BackgroundTertiary}"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding Path=JobSummary}" FontSize="11" Foreground="{StaticResource TextSecondary}" Padding="0,0,0,10" TextWrapping="WrapWithOverflow" HorizontalAlignment="Center" TextAlignment="Center"/>

                                <StackPanel Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Path=DepartureICAO}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Departure" FontSize="10" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                                    <Border Height="2" CornerRadius="1" MinWidth="100" Margin="0,0,0,4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#3b82f6"/>
                                                <GradientStop Offset="1" Color="#60a5fa"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding Path=DistComplete}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Distance" FontSize="12" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Path=ArrivalICAO}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Arrival" FontSize="10" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE707;" FontSize="14" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0"/>
                                    <TextBlock Text="ALT: " FontSize="14" Foreground="{StaticResource TextTertiary}"/>
                                    <TextBlock Text="{Binding Path=AlternativeICAO}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource BackgroundSecondary}"
                                CornerRadius="10"
                                Padding="16,12"
                                BorderBrush="{StaticResource BorderPrimary}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.Row="0" Width="26" Height="26" CornerRadius="6" Background="{StaticResource InfoBg}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE902;" FontSize="12" Foreground="{StaticResource Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Path=PaxComplete}" FontSize="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Path=PaxTotalWeight}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <Border Grid.Column="0" Grid.Row="1" Width="26" Height="26" CornerRadius="6" Background="{StaticResource WarningBg}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE821;" FontSize="12" Foreground="{StaticResource Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="Cargo:" FontSize="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Path=CargoComplete}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0"/>

                                <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Height="1" Background="{StaticResource BorderPrimary}" Margin="0,10,0,10" CornerRadius="1"/>

                                <TextBlock Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Text="Total payload:" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Grid.Row="3" Text="{Binding Path=PayloadComplete}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" Height="1" Background="{StaticResource BorderPrimary}" Margin="0,10,0,100" CornerRadius="1"/>

                                <StackPanel Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,24,0,0">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource SuccessBg}" Margin="0,0,8,0">
                                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF4A5;" FontSize="18" Foreground="{StaticResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Payment:" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Grid.Row="4" Text="{Binding Path=PayComplete}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,14,0,0"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="btnStartBorder" Grid.Column="0" Margin="0,0,6,0"
                                    Background="{StaticResource SuccessBg}"
                                    BorderBrush="#22c55e50"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    IsEnabled="{Binding StartIsEnable}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessBgHover}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Width="Auto" MinWidth="100" Height="36" Click="btnStart_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEDDA;" FontSize="12" Foreground="{StaticResource Success}" Margin="0,0,6,0" />
                                        <TextBlock Text="Start" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border x:Name="btnFinishBorder" Grid.Column="1" Margin="6,0,0,0"
                                    Background="{StaticResource AccentPrimaryBg}"
                                    BorderBrush="#3b82f650"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    IsEnabled="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentPrimaryBgHover}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Width="Auto" MinWidth="100" Height="36" Click="btnFinish_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71A;" FontSize="12" Foreground="{StaticResource AccentPrimary}" Margin="0,0,6,0" />
                                        <TextBlock Text="Finish" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
