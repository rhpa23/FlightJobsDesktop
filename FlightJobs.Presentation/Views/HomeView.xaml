<UserControl x:Class="FlightJobsDesktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:FlightJobsDesktop.Views.Home"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d">
    <Grid>
        <TabControl x:Name="TabControlHome"                    
                    MinHeight="400" MinWidth="1000">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Connector" FontSize="22" Style="{DynamicResource CustomTabItem}" />
                    </StackPanel>
                </TabItem.Header>
                <views:ConnectorView />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Practice" FontSize="22" Style="{DynamicResource CustomTabItem}" />
                    </StackPanel>
                </TabItem.Header>
                <views:PracticeView/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Web App" FontSize="22" Style="{DynamicResource CustomTabItem}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="Black">
                    <views:WebAppView />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
