<Window x:Class="FlightJobsDesktop.Views.SlidersWindows.CurrentJobDataWindow"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlightJobsDesktop.ViewModels"
        xmlns:lc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d" MouseDown="HideIco_MouseDown"
        xmlns:wf="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        Title="FlightJobs - Job data Slider" Cursor="Hand" Style="{DynamicResource BorderHighlightWindow}" Loaded="Window_Loaded"
        SizeToContent="Height" Width="4" Topmost="True" WindowStyle="None" Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" ResizeMode="NoResize" Left="-1" Top="30" ShowInTaskbar="False">
    <Window.DataContext>
        <local:CurrentJobViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="OpacityMouseOverEffect" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="StackPanel.Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style for Gauge Cards with Rounded Corners and Hover States -->
        <Style x:Key="GaugeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderSecondary}"/>
                    <Setter Property="Background" Value="{StaticResource BackgroundTertiary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Slider Panel -->
        <StackPanel Orientation="Vertical" Height="Auto" Margin="0,0,0,15">
            <!-- Header Grid Title -->
            <Grid x:Name="GridTitle" Background="{StaticResource BackgroundSecondary}" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <ui:FontIcon x:Name="StartedIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xEC3F;" Visibility="Hidden"
                          Foreground="{StaticResource Success}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" />
                <TextBlock Text="{Binding SliderTopTitle}" Style="{StaticResource TextPrimaryStyle}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
                <ui:FontIcon x:Name="HideIco" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A0;" 
                          Foreground="{StaticResource TextSecondary}" Cursor="Hand" ToolTip="Hide Slider" FontSize="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="HideIco_MouseDown" Grid.Column="2" />
            </Grid>
            <!-- Border line below header -->
            <Border Height="1" Background="{StaticResource BorderPrimary}"/>
            
            <TextBlock x:Name="TxbFPS" Style="{StaticResource TextSecondaryStyle}" FontSize="10" TextTrimming="WordEllipsis" Width="145" Margin="0,8,0,0" TextAlignment="Center" HorizontalAlignment="Center">
                <Run Text="FPS: "/><Run Text="{Binding SimData.FPS}"/>
            </TextBlock>
            <TextBlock x:Name="TxbCapacityName" Style="{StaticResource TextSecondaryStyle}" FontSize="10" TextTrimming="WordEllipsis" Width="145" Margin="0,4,0,0" HorizontalAlignment="Center" />
            
            <!-- Capacity image container with rounded corners and border -->
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderPrimary}" ClipToBounds="True" Margin="10,8,10,0" Height="60">
                <Image x:Name="ImgCapacity" Source="/img/background/default_thumb-capacity.jpg" Stretch="UniformToFill"/>
            </Border>
            
            <Grid x:Name="GridRoute" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Image Source="/img/icons/departing.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Vertical" Grid.Column="1" Grid.RowSpan="2">
                    <Image Source="/img/logo/FlightJobsLogo0004.png" Margin="0,7,0,0" Height="14" Stretch="Uniform"/>
                    <Border Height="1" Background="{StaticResource BorderPrimary}" Margin="0,5,0,0"/>
                    <TextBlock x:Name="TxbDistance" Text="{Binding DistComplete}" Foreground="{StaticResource AccentPrimary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <Image Source="/img/icons/arrival.png" Width="24" Height="24" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DepartureICAO}" Grid.Row="1" Style="{StaticResource TextPrimaryStyle}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ArrivalICAO}" Grid.Row="1" Style="{StaticResource TextPrimaryStyle}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Grid.Column="2" />
            </Grid>
            
            <Border Height="1" Background="{StaticResource BorderPrimary}" Margin="10,10,10,0"/>
            
            <!-- Simulation Data Grid -->
            <Grid x:Name="GridSimData" Margin="15,10,15,0" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Payload:" Style="{StaticResource TextSecondaryStyle}" FontWeight="Bold" Margin="0,8,0,0" Grid.Column="0" Grid.Row="0"/>
                <TextBlock Text="{Binding PayloadComplete}" Foreground="{Binding PayloadLabelColor}" FontWeight="Bold" Margin="0,8,0,0" Grid.Column="1" Grid.Row="0"/>
                
                <TextBlock Text="Pax:" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,0" Grid.Column="0" Grid.Row="1"/>
                <TextBlock Text="{Binding Pax}" Foreground="{Binding IsConnectedColor}" FontWeight="SemiBold" Margin="0,4,0,0" Grid.Column="1" Grid.Row="1"/>
                
                <TextBlock Text="Cargo:" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,0" Grid.Column="0" Grid.Row="2"/>
                <TextBlock Text="{Binding CargoComplete}" Foreground="{Binding IsConnectedColor}" FontWeight="SemiBold" Margin="0,4,0,0" Grid.Column="1" Grid.Row="2"/>
                
                <TextBlock Text="Wind:" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,0" Grid.Column="0" Grid.Row="3"/>
                <TextBlock Text="{Binding SimData.WindDirectionAndSpeedText}" Foreground="{Binding IsConnectedColor}" FontWeight="SemiBold" Margin="0,4,0,0" Grid.Column="1" Grid.Row="3"/>
                
                <TextBlock Text="Temp:" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,0" Grid.Column="0" Grid.Row="4"/>
                <TextBlock Text="{Binding SimData.TemperatureCelsiusText}" Foreground="{Binding IsConnectedColor}" FontWeight="SemiBold" Margin="0,4,0,0" Grid.Column="1" Grid.Row="4"/>
                
                <TextBlock Text="Pressure:" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,4" Grid.Column="0" Grid.Row="5"/>
                <TextBlock Text="{Binding SimData.SeaLevelPressureText}" Foreground="{Binding IsConnectedColor}" FontWeight="SemiBold" Margin="0,4,0,4" Grid.Column="1" Grid.Row="5"/>
            </Grid>
            
            <!-- Landing Summary Panel (Shown during simulation/landing phase) -->
            <Grid x:Name="GridLanding" Margin="10,0,10,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Landing Title Header -->
                <Border Grid.ColumnSpan="3" Background="{StaticResource BackgroundSecondary}" CornerRadius="4" Margin="0,10,0,8" Padding="6,4">
                    <TextBlock Style="{StaticResource TextPrimaryStyle}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="Landing "/><Run Text="{Binding PlaneSimData.TouchdownRunwayDesignator}"/>
                    </TextBlock>
                </Border>

                <!-- Wind -->
                <Ellipse Width="8" Height="8" Fill="{Binding PlaneSimData.ColorResultTouchdownWindSpeed}" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Wind:" Style="{StaticResource TextSecondaryStyle}" Grid.Row="1" Grid.Column="1" Margin="4,4,0,4" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="2" Margin="0,4,0,4" VerticalAlignment="Center">
                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF0AD;" Foreground="{Binding PlaneSimData.ColorResultTouchdownWindAngle}" FontSize="10" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"> 
                        <ui:FontIcon.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="{Binding PlaneSimData.TouchdownWindAngle}"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </ui:FontIcon.RenderTransform>
                    </ui:FontIcon>
                    <TextBlock Text="{Binding PlaneSimData.TouchdownWindSpeedText}" Style="{StaticResource TextPrimaryStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Air speed -->
                <Ellipse Width="8" Height="8" Fill="Green" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Air speed:" Style="{StaticResource TextSecondaryStyle}" Grid.Row="2" Grid.Column="1" Margin="4,4,0,4" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PlaneSimData.TouchdownAirspeedText}" Style="{StaticResource TextPrimaryStyle}" Grid.Row="2" Grid.Column="2" Margin="0,4,0,4" VerticalAlignment="Center"/>
                
                <!-- Ground speed -->
                <Ellipse Width="8" Height="8" Fill="Green" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Ground speed:" Style="{StaticResource TextSecondaryStyle}" Grid.Row="3" Grid.Column="1" Margin="4,4,0,4" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PlaneSimData.TouchdownGroundspeedText}" Style="{StaticResource TextPrimaryStyle}" Grid.Row="3" Grid.Column="2" Margin="0,4,0,4" VerticalAlignment="Center"/>
            </Grid>
            
            <!-- Quick Flight Results Panel -->
            <Grid x:Name="GridResults" Margin="10,0,10,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Results Title Header -->
                <Border Grid.ColumnSpan="3" Background="{StaticResource BackgroundSecondary}" CornerRadius="4" Margin="0,10,0,8" Padding="6,4">
                    <TextBlock Style="{StaticResource TextPrimaryStyle}" Text="Results" FontWeight="Bold" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Pilot Payment -->
                <Ellipse Width="8" Height="8" Fill="Green" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Pilot Payment:" Style="{StaticResource TextSecondaryStyle}" Grid.Row="1" Grid.Column="1" Margin="4,4,0,4" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PayComplete}" Style="{StaticResource TextPrimaryStyle}" Grid.Row="1" Grid.Column="2" Margin="0,4,0,4" VerticalAlignment="Center"/>

                <!-- Flight Time -->
                <Ellipse Width="8" Height="8" Fill="Green" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Flight time:" Style="{StaticResource TextSecondaryStyle}" Grid.Row="2" Grid.Column="1" Margin="4,4,0,4" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Path=LastJob.FlightTime, Mode=TwoWay}" Style="{StaticResource TextPrimaryStyle}" Grid.Row="2" Grid.Column="2" Margin="0,4,0,4" VerticalAlignment="Center"/>

                <!-- Score Button -->
                <Button x:Name="BtnShowFlightResults" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource ButtonPrimaryStyle}" Height="32" Width="130" Margin="0,12,0,0" Click="BtnShowFlightResults_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" Foreground="White" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="Score"/> <Run Text="{Binding Score}" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Exit Button -->
                <Button x:Name="BtnCloseApp" Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource ButtonGhostStyle}" Height="32" Width="130" Margin="0,8,0,0" Click="BtnCloseApp_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="Exit"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            
            <!-- Warning / Message Area -->
            <Grid x:Name="GridMessage" Margin="10,12,10,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF473;" VerticalAlignment="Top" Margin="0,2,0,0"
                          Foreground="{StaticResource Warning}" FontSize="16" Grid.Column="0" />
                <TextBlock Text="{Binding SliderMessage}" Grid.Column="1" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="11" Margin="0"/>
            </Grid>
        </StackPanel>
        
        <!-- Right Detailed Results Slider Area -->
        <Border x:Name="ResultAreaBorder" Background="{StaticResource BackgroundPrimary}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderPrimary}" Grid.Column="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <!-- Close Detailed Results Button -->
                <Button x:Name="BtnCloseResults" Grid.Column="1" Margin="0,10,15,0" Panel.ZIndex="500"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnCloseResults_Click"
                        Style="{StaticResource ButtonGhostStyle}" Width="32" Height="32" Padding="0">
                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A0;" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                
                <!-- Results Tab Control -->
                <TabControl x:Name="TabControlResults" Margin="15,5,15,15" Grid.ColumnSpan="2" SelectionChanged="TabControlResults_SelectionChanged"
                    Style="{StaticResource ModernTabControl}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItem}"/>
                    </TabControl.Resources>
                    
                    <!-- Tab 1: Flight results (Gauges & Lists) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" Margin="0,0,8,0" FontSize="14" Foreground="{StaticResource AccentPrimary}"/>
                                <Label Content="Flight results" FontSize="14" Style="{StaticResource CustomTabItem}" />
                            </StackPanel>
                        </TabItem.Header>
                        
                        <Grid Margin="0,15,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="260"/>
                                <RowDefinition Height="260"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Gauge Card 1: Takeoff Center Derivation -->
                            <Border Style="{StaticResource GaugeCardStyle}" Width="190" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Border.ToolTip>
                                    <ToolTip Background="{StaticResource BackgroundSecondary}" 
                                             BorderBrush="{StaticResource BorderPrimary}" 
                                             BorderThickness="1" 
                                             Padding="12" 
                                             MaxWidth="320">
                                        <StackPanel>
                                            <TextBlock Text="Takeoff Center Derivation" 
                                                       Foreground="{StaticResource TextPrimary}" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Takeoff Center Derivation measures the lateral distance between the aircraft’s centerline and the runway centerline at the moment of liftoff, indicating directional control during the takeoff roll." 
                                                       Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">Why It Happens:</Run> Results from uncorrected crosswinds, improper heading corrections (over-correcting with rudder), or engine failure during takeoff (V1 cut) without prompt decisive action.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Error}">Why It Must Be Avoided:</Run> Excessive lateral deviation at liftoff significantly increases the risk of a runway excursion, especially in gusty conditions. It can also lead to asymmetrical lift if one main gear lifts off early.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Success}">Standard Recovery:</Run> Pilots must maintain directional control using rudder. A maximum lateral deviation of 2-3 meters (approx. 6-10 ft) is generally considered acceptable for certification.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel>
                                    <ui:LayoutPanel>
                                        <lc:AngularGauge Width="170" Height="180" Foreground="White" FromValue="0" ToValue="10" TicksStep="1" Value="{Binding PlaneSimData.TakeoffCenterDerivation}" SectionsInnerRadius="0.7" >
                                            <lc:AngularGauge.Sections>
                                                <lc:AngularSection FromValue="0" ToValue="3" Fill="Green"/>
                                                <lc:AngularSection FromValue="3" ToValue="6" Fill="Orange"/>
                                                <lc:AngularSection FromValue="6" ToValue="10" Fill="Red"/>
                                            </lc:AngularGauge.Sections>
                                        </lc:AngularGauge>
                                        <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="65,55,65,100" HorizontalAlignment="Center" MinWidth="45">
                                            <TextBlock Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center">
                                                <Run Text="{Binding PlaneSimData.TakeoffCenterDerivation}"/>
                                                <Run Text="m" FontSize="10"/>
                                            </TextBlock>
                                        </Border>
                                    </ui:LayoutPanel>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" TextAlignment="Center">Takeoff center derivation</TextBlock>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,2,0,10" FontSize="12">
                                        <Run Text="Score: "/>
                                        <Run Foreground="{Binding PlaneSimData.ColorResultTakeoffCenterDerivation}" Text="{Binding PlaneSimData.ScoreTakeoffCenterDerivation, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- Gauge Card 2: Touchdown VS -->
                            <Border Style="{StaticResource GaugeCardStyle}" Width="190" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border.ToolTip>
                                    <ToolTip Background="{StaticResource BackgroundSecondary}" 
                                             BorderBrush="{StaticResource BorderPrimary}" 
                                             BorderThickness="1" 
                                             Padding="12" 
                                             MaxWidth="320">
                                        <StackPanel>
                                            <TextBlock Text="Touchdown Vertical Speed (VS)" 
                                                       Foreground="{StaticResource TextPrimary}" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Touchdown Vertical Speed (VS) measures the rate of descent of the aircraft at the precise moment of main wheel contact with the runway surface." 
                                                       Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">Why It Happens:</Run> Primarily determined by the flare execution (the pilot’s action to raise the nose and arrest the descent) and the aircraft’s weight. A late or insufficient flare causes a high sink rate.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Error}">Why It Must Be Avoided:</Run> High sink rates (e.g., > 500 ft/min) result in hard landings that can damage landing gear, fuselage structure, and avionics. It also increases the risk of a bounce or runway excursion.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Success}">Standard Recovery:</Run> Pilots aim to reduce vertical speed to near zero at touchdown. For heavy jets, optimal landing sink rates are typically below 200 ft/min. Anything above 300 ft/min is generally considered excessive.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel>
                                    <ui:LayoutPanel>
                                        <lc:AngularGauge Name="AngularGaugeTouchdownFpm" Width="170" Height="180" Foreground="White" FromValue="0" ToValue="700" TicksStep="100" SectionsInnerRadius="0.7" >
                                            <lc:AngularGauge.Sections>
                                                <lc:AngularSection FromValue="0" ToValue="180" Fill="Green"/>
                                                <lc:AngularSection FromValue="180" ToValue="260" Fill="Orange"/>
                                                <lc:AngularSection FromValue="260" ToValue="700" Fill="Red"/>
                                            </lc:AngularGauge.Sections>
                                        </lc:AngularGauge>
                                        <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="55,55,55,100" HorizontalAlignment="Center" MinWidth="60">
                                            <TextBlock Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center">
                                                <Run Text="{Binding PlaneSimData.TouchdownFpm}"/>
                                                <Run Text="fpm" FontSize="9"/>
                                            </TextBlock>
                                        </Border>
                                    </ui:LayoutPanel>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" TextAlignment="Center">Touchdown VS</TextBlock>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,2,0,10" FontSize="12">
                                        <Run Text="Score: "/>
                                        <Run Foreground="{Binding PlaneSimData.ColorResultTouchdownFpm}" Text="{Binding PlaneSimData.ScoreTouchdown, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- Gauge Card 3: Touchdown G-Force -->
                            <Border Style="{StaticResource GaugeCardStyle}" Width="190" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Border.ToolTip>
                                    <ToolTip Background="{StaticResource BackgroundSecondary}" 
                                             BorderBrush="{StaticResource BorderPrimary}" 
                                             BorderThickness="1" 
                                             Padding="12" 
                                             MaxWidth="320">
                                        <StackPanel>
                                            <TextBlock Text="Touchdown G-Force (Hard Landing)" 
                                                       Foreground="{StaticResource TextPrimary}" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Touchdown G-Force measures the peak vertical acceleration experienced by the aircraft at the exact moment of wheel-to-ground contact, indicating the structural impact of the landing." 
                                                       Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">Why It Happens:</Run> Caused by a high sink rate (vertical speed) during flare, wind shear or sudden loss of lift just before touchdown, improper flare timing (flaring too late), or high aircraft weight.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Error}">Why It Must Be Avoided:</Run> High G-forces indicate a &quot;Hard Landing&quot;, which can cause immediate structural damage to the fuselage, collapse the landing gear, blow out tires, or mandate expensive, time-consuming maintenance inspections before the next flight.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Info}">Standard Thresholds:</Run> Normal landings range from 1.1G to 1.4G. Touchdowns exceeding 2.0G typically trigger automated aircraft maintenance alerts.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel>
                                    <ui:LayoutPanel>
                                        <lc:AngularGauge Name="AngularGaugeGForce" Width="170" Height="180" Foreground="White" FromValue="0" ToValue="5" TicksStep="1" SectionsInnerRadius="0.7" >
                                            <lc:AngularGauge.Sections>
                                                <lc:AngularSection FromValue="0" ToValue="1.2" Fill="Green"/>
                                                <lc:AngularSection FromValue="1.2" ToValue="1.4" Fill="Orange"/>
                                                <lc:AngularSection FromValue="1.4" ToValue="5" Fill="Red"/>
                                            </lc:AngularGauge.Sections>
                                        </lc:AngularGauge>
                                        <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="65,55,65,100" HorizontalAlignment="Center" MinWidth="45">
                                            <TextBlock Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center">
                                                <Run Text="{Binding PlaneSimData.TouchdownGForceText}"/>
                                            </TextBlock>
                                        </Border>
                                    </ui:LayoutPanel>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" TextAlignment="Center">Touchdown G-Force</TextBlock>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,2,0,10" FontSize="12">
                                        <Run Text="Score: "/>
                                        <Run Foreground="{Binding PlaneSimData.ColorResultGForce}" Text="{Binding PlaneSimData.ScoreGForce, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- Gauge Card 4: Landing Center Derivation -->
                            <Border Style="{StaticResource GaugeCardStyle}" Width="190" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Border.ToolTip>
                                    <ToolTip Background="{StaticResource BackgroundSecondary}" 
                                             BorderBrush="{StaticResource BorderPrimary}" 
                                             BorderThickness="1" 
                                             Padding="12" 
                                             MaxWidth="320">
                                        <StackPanel>
                                            <TextBlock Text="Runway Centerline Deviation" 
                                                       Foreground="{StaticResource TextPrimary}" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Runway Centerline Deviation refers to the lateral distance between the aircraft’s landing gear and the physical center of the runway during touchdown and rollout." 
                                                       Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">Why It Happens:</Run> Primarily caused by uncorrected crosswinds, improper crab or sideslip compensation (crosswind landing technique), late alignment corrections, or sudden wind shear.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Error}">Why It Must Be Avoided:</Run> Exceeding lateral limits significantly increases the risk of a runway excursion (veering off the paved surface), colliding with runway lights/signage, or damaging the landing gear due to excessive side-loading.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Success}">Standard Recovery:</Run> Pilots must maintain precise directional control using rudder and aileron inputs. If the aircraft cannot be realigned before touchdown or stabilizes poorly during rollout, an immediate Go-Around or maximum braking must be initiated.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel>
                                    <ui:LayoutPanel>
                                        <lc:AngularGauge Width="170" Height="180" Foreground="White" FromValue="0" ToValue="10" TicksStep="1" Value="{Binding PlaneSimData.TouchdownCenterDerivation}" SectionsInnerRadius="0.7" >
                                            <lc:AngularGauge.Sections>
                                                <lc:AngularSection FromValue="0" ToValue="3" Fill="Green"/>
                                                <lc:AngularSection FromValue="3" ToValue="6" Fill="Orange"/>
                                                <lc:AngularSection FromValue="6" ToValue="10" Fill="Red"/>
                                            </lc:AngularGauge.Sections>
                                        </lc:AngularGauge>
                                        <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="65,55,65,100" HorizontalAlignment="Center" MinWidth="45">
                                            <TextBlock Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center">
                                                <Run Text="{Binding PlaneSimData.TouchdownCenterDerivation}"/>
                                                <Run Text="m" FontSize="10"/>
                                            </TextBlock>
                                        </Border>
                                    </ui:LayoutPanel>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" TextAlignment="Center">Landing center derivation</TextBlock>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,2,0,10" FontSize="12">
                                        <Run Text="Score: "/>
                                        <Run Foreground="{Binding PlaneSimData.ColorResultCenterDerivation}" Text="{Binding PlaneSimData.ScoreCenterDerivation, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- Gauge Card 5: Bounce(s) -->
                            <Border Style="{StaticResource GaugeCardStyle}" Width="190" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border.ToolTip>
                                    <ToolTip Background="{StaticResource BackgroundSecondary}" 
                                             BorderBrush="{StaticResource BorderPrimary}" 
                                             BorderThickness="1" 
                                             Padding="12" 
                                             MaxWidth="320">
                                        <StackPanel>
                                            <TextBlock Text="Runway Bouncing (Bounced Landing)" 
                                                       Foreground="{StaticResource TextPrimary}" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="A bounced landing occurs when an aircraft touches down and immediately becomes airborne again due to excessive vertical energy or an improper landing attitude." 
                                                       Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">Why It Happens:</Run> Caused by excessive airspeed on final approach, high sink rate (hard impact), incorrect pitch attitude (landing nose-first or flat), or improper use of flight controls during flare.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Error}">Why It Must Be Avoided:</Run> It creates a high risk of nose gear collapse, tail strikes, structural damage, or a complete loss of control (porpoising) on subsequent impacts.
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="16" 
                                                       Margin="0,4,0,0">
                                                • <Run FontWeight="Bold" Foreground="{StaticResource Success}">Standard Recovery:</Run> Pilots must either maintain a safe pitch attitude to let the aircraft resettle smoothly or immediately execute a Go-Around (rejected landing).
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel>
                                    <ui:LayoutPanel>
                                        <lc:AngularGauge Width="170" Height="180" Foreground="White" FromValue="0" ToValue="3" Value="{Binding PlaneSimData.TouchdownBounceCount}" SectionsInnerRadius="0.7" >
                                            <lc:AngularGauge.Sections>
                                                <lc:AngularSection FromValue="0" ToValue="0.5" Fill="Green"/>
                                                <lc:AngularSection FromValue="0.5" ToValue="1.5" Fill="Orange"/>
                                                <lc:AngularSection FromValue="1.5" ToValue="3" Fill="Red"/>
                                            </lc:AngularGauge.Sections>
                                        </lc:AngularGauge>
                                        <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="65,55,65,100" HorizontalAlignment="Center" MinWidth="45">
                                            <TextBlock Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center">
                                                <Run Text="{Binding PlaneSimData.TouchdownBounceCount}"/>
                                            </TextBlock>
                                        </Border>
                                    </ui:LayoutPanel>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" TextAlignment="Center">Bounce(s)</TextBlock>
                                    <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,2,0,10" FontSize="12">
                                        <Run Text="Score: "/>
                                        <Run Foreground="{Binding PlaneSimData.ColorResultBounceCount}" Text="{Binding PlaneSimData.ScoreBounce, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- Gauge Card 6: Landing Distance -->
                            <Border Style="{StaticResource GaugeCardStyle}" Width="190" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Border.ToolTip>
                                    <ToolTip Background="{StaticResource BackgroundSecondary}" 
                                             BorderBrush="{StaticResource BorderPrimary}" 
                                             BorderThickness="1" 
                                             Padding="12" 
                                             MaxWidth="320">
                                        <StackPanel>
                                            <TextBlock Text="Runway Aiming Point Distance" 
                                                       Foreground="{StaticResource TextPrimary}" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="The distance from the threshold (runway start) to the aiming point (ideal touchdown zone) is a fixed distance based on the Runway Landing Distance Available (LDA):" 
                                                       Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" 
                                                       FontSize="11" 
                                                       Margin="8,0,0,8" 
                                                       LineHeight="16">
                                                • Under 800m: <Run Foreground="{StaticResource Info}" FontWeight="SemiBold">150m</Run> (approx. 500 ft)<LineBreak/>
                                                • 800m to 1,200m: <Run Foreground="{StaticResource Info}" FontWeight="SemiBold">250m</Run> (approx. 800 ft)<LineBreak/>
                                                • 1,200m to 2,400m: <Run Foreground="{StaticResource Info}" FontWeight="SemiBold">300m</Run> (approx. 1,000 ft)<LineBreak/>
                                                • Over 2,400m: <Run Foreground="{StaticResource Info}" FontWeight="SemiBold">400m</Run> (approx. 1,300 ft)
                                            </TextBlock>
                                            <TextBlock Text="Note: These fixed standards comply with ICAO Annex 14 and FAA regulations to guarantee obstacle clearance during final approach." 
                                                       Foreground="{StaticResource TextTertiary}" 
                                                       FontSize="10" 
                                                       TextWrapping="Wrap" 
                                                       FontStyle="Italic"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel>
                                    <Canvas x:Name="CanvasDistanceIndicator" Width="170" Height="180" HorizontalAlignment="Center">
                                         <!-- Left Labels -->
                                         <TextBlock x:Name="LblValMax" Foreground="{StaticResource TextSecondary}" FontSize="12" Width="45" TextAlignment="Right" Canvas.Left="5" Canvas.Top="0"/>
                                         <TextBlock x:Name="LblValGreenTop" Foreground="{StaticResource TextSecondary}" FontSize="12" Width="45" TextAlignment="Right" Canvas.Left="5"/>
                                         <TextBlock x:Name="LblValGreenBottom" Foreground="{StaticResource TextSecondary}" FontSize="12" Width="45" TextAlignment="Right" Canvas.Left="5"/>
                                         <TextBlock x:Name="LblValMin" Foreground="{StaticResource TextSecondary}" FontSize="12" Width="45" TextAlignment="Right" Canvas.Left="5" Canvas.Bottom="0" Text="0"/>

                                         <!-- Vertical Bar -->
                                         <Border Canvas.Left="55" Canvas.Top="0" Width="45" Height="180" CornerRadius="2" ClipToBounds="True">
                                             <Grid x:Name="GridBarZones">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition x:Name="RowTopRed" Height="1*"/>
                                                     <RowDefinition x:Name="RowGreen" Height="1*"/>
                                                     <RowDefinition x:Name="RowBottomRed" Height="1*"/>
                                                 </Grid.RowDefinitions>
                                                 <Border Grid.Row="0" Background="{StaticResource Error}"/>
                                                 <Border Grid.Row="1" Background="{StaticResource Success}"/>
                                                 <Border Grid.Row="2" Background="{StaticResource Error}"/>
                                             </Grid>
                                         </Border>

                                         <!-- Indicator Line and Label -->
                                         <StackPanel x:Name="IndicatorGroup" Orientation="Horizontal" Canvas.Left="40" Canvas.Top="90">
                                             <Border Margin="11,0,0,0" Height="2" Width="55" Background="White" SnapsToDevicePixels="True" CornerRadius="1">
                                                 <Border.Effect>
                                                     <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
                                                 </Border.Effect>
                                             </Border>
                                             <TextBlock x:Name="LblCurrentDistance" Margin="5,0,0,0" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Canvas>
                                     <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" TextAlignment="Center">Landing distance</TextBlock>
                                     <TextBlock Style="{StaticResource TextSecondaryStyle}" HorizontalAlignment="Center" Margin="0,2,0,10" FontSize="12">
                                         <Run Text="Score: "/>
                                         <Run Foreground="{Binding PlaneSimData.ColorResultLandDistance}" Text="{Binding PlaneSimData.ScoreLandDistance, Mode=OneWay}" FontWeight="Bold"/>
                                     </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- Upwind Landing Score Row -->
                            <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ListItemStyle}" Margin="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding MsgResults.UpwindLandingScoreTitle}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding MsgResults.UpwindLandingScoreSubTitle}" Style="{StaticResource TextSecondaryStyle}" FontWeight="Light" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PlaneSimData.ScoreWindAngle, Mode=OneWay}" Foreground="{Binding PlaneSimData.ColorResultTouchdownWindAngle}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                                </Grid>
                            </Border>

                            <!-- Beacon Lights Score Row -->
                            <Border Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource ListItemStyle}" Margin="0,4,0,0" Visibility="{Binding FlightResults.ResultBeaconLightVisibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding MsgResults.BeaconLightsScoreTitle}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding MsgResults.BeaconLightsScoreSubTitle}" Style="{StaticResource TextSecondaryStyle}" FontWeight="Light" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PlaneSimData.ScoreLightBeaconOn, Mode=OneWay}" Foreground="{StaticResource Warning}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                                </Grid>
                            </Border>

                            <!-- Landing Lights Score Row -->
                            <Border Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource ListItemStyle}" Margin="0,4,0,0" Visibility="{Binding FlightResults.ResultLandingLightVisibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding MsgResults.LandingLightsScoreTitle}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding MsgResults.LandingLightsScoreSubTitle}" Style="{StaticResource TextSecondaryStyle}" FontWeight="Light" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PlaneSimData.ScoreLightLandingOn, Mode=OneWay}" Foreground="{StaticResource Warning}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                                </Grid>
                            </Border>

                            <!-- Navigation Lights Score Row -->
                            <Border Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource ListItemStyle}" Margin="0,4,0,0" Visibility="{Binding FlightResults.ResultNavigationLightVisibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding MsgResults.NavegationLightsScoreTitle}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding MsgResults.NavegationLightsScoreSubTitle}" Style="{StaticResource TextSecondaryStyle}" FontWeight="Light" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PlaneSimData.ScoreLightNavigationOn, Mode=OneWay}" Foreground="{StaticResource Warning}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                                </Grid>
                            </Border>

                            <!-- Altimeter Score Row -->
                            <Border Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Style="{StaticResource ListItemStyle}" Margin="0,4,0,0" Visibility="{Binding FlightResults.ResultAltimeterSettingVisibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding MsgResults.AltimeterScoreTitle}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding MsgResults.AltimeterScoreSubTitle}" Style="{StaticResource TextSecondaryStyle}" FontWeight="Light" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PlaneSimData.ScoreAltimeterSettings, Mode=OneWay}" Foreground="{StaticResource Warning}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                                </Grid>
                            </Border>
                            
                            <!-- Total Score Area Card -->
                            <Border Grid.Column="2" Grid.Row="2" Grid.RowSpan="5" Style="{StaticResource CardSubtleStyle}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" Margin="15,20,0,0" VerticalAlignment="Stretch" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding MsgResults.TotalScoreTitle}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="{Binding MsgResults.TotalScoreSubTitle}" TextWrapping="Wrap" Style="{StaticResource TextSecondaryStyle}" FontSize="12" Margin="0,0,0,16" />
                                    <TextBlock Grid.Row="2" Text="{Binding Score, Mode=OneWay}" Foreground="{StaticResource Success}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="36" />
                                </Grid>
                            </Border>
                        </Grid>                        
                    </TabItem>
                    
                    <!-- Tab 2: Flight recorder (Charts, Route Map, stats) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D9;" Margin="0,0,8,0" FontSize="14" Foreground="{StaticResource AccentPrimary}"/>
                                <Label Content="Flight recorder" FontSize="14" Style="{StaticResource CustomTabItem}" />
                            </StackPanel>
                        </TabItem.Header>
                        
                        <StackPanel Orientation="Vertical" Margin="0,15,0,0">
                            <!-- Chart Area (Kept intact) -->
                            <WindowsFormsHost x:Name="WindowsChartArea" Margin="0,0,0,0" Height="300">
                                <wf:Chart x:Name="ChartFlightRecorder">
                                    <wf:Chart.Series>
                                        <wf:Series ChartType="Spline" IsValueShownAsLabel="False" IsVisibleInLegend="True" MarkerSize="0" MarkerStyle="Circle" MarkerColor="LightGreen" 
                                                           BorderWidth="2" LabelBackColor="White" />
                                    </wf:Chart.Series>
                                    <wf:Chart.ChartAreas>
                                        <wf:ChartArea />
                                    </wf:Chart.ChartAreas>
                                </wf:Chart>
                            </WindowsFormsHost>
                            
                            <!-- Route Map Panel -->
                            <DockPanel x:Name="RouteMapPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" 
                                       Margin="0" LastChildFill="True" Height="300" Visibility="Collapsed">
                                <wv2:WebView2 x:Name="RouteMapWebView"  />
                            </DockPanel>
                            
                            <Border Height="1" Background="{StaticResource BorderPrimary}" Margin="0,15,0,15" />
                            
                            <!-- Chart Variable Selectors (Radio Buttons) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton x:Name="RadioAltitude" Content="Altitude" Foreground="{StaticResource TextPrimary}" Margin="5,0" Checked="ChartTypeRadioButton_Checked"/>
                                <RadioButton x:Name="RadioSpeed" Content="Speed" Foreground="{StaticResource TextPrimary}" Margin="5,0" Checked="ChartTypeRadioButton_Checked"/>
                                <RadioButton x:Name="RadioFuel" Content="Fuel" Foreground="{StaticResource TextPrimary}" Margin="5,0" Checked="ChartTypeRadioButton_Checked"/>
                                <RadioButton x:Name="RadioFps" Content="FPS" Foreground="{StaticResource TextPrimary}" Margin="5,0" Checked="ChartTypeRadioButton_Checked"/>
                                <RadioButton x:Name="RadioRoteMap" Content="Route" Foreground="{StaticResource TextPrimary}" Margin="5,0" Checked="ChartTypeRadioButton_Checked"/>
                            </StackPanel>
                            
                            <!-- Bottom Stats Bar -->
                            <Border Style="{StaticResource CardSubtleStyle}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" Margin="0,15,0,0" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE821;" FontSize="14" Foreground="{StaticResource Warning}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource TextPrimaryStyle}" FontSize="13" VerticalAlignment="Center">
                                            <Run Text="Average fuel consumption: " Foreground="{StaticResource TextSecondary}"/>
                                            <Run FontWeight="Bold" Text="{Binding FlightRecorderAnalise.AverageFuelConsumptioText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE709;" FontSize="14" Foreground="{StaticResource AccentPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource TextPrimaryStyle}" FontSize="13" VerticalAlignment="Center">
                                            <Run Text="Average speed: " Foreground="{StaticResource TextSecondary}"/>
                                            <Run FontWeight="Bold" Text="{Binding FlightRecorderAnalise.AveragePlaneSpeedText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
